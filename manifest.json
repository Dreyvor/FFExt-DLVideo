{
  "manifest_version": 2,
  "name": "VideoDL",
  "version": "1.0.0",
  "description": "Discover and download non-DRM media from websites.",
  "permissions": [
    "activeTab",
    "downloads",
    "tabs",
    "webRequest",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/shared.js",
      "src/background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_popup": "src/popup.html",
    "default_title": "VideoDL"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "videodl@local",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "142.0"
    }
  }
}
